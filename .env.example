# TMDB v4 read access token (a long JWT-style string), not the shorter v3 api_key.
# The watch-provider endpoints reject the v3 api_key scheme outright.
# Get it from https://www.themoviedb.org/settings/api under "API Read Access Token".
TMDB_READ_ACCESS_TOKEN=

# The shared family password, as a scrypt digest. Never the password itself and
# never a default: with this unset the app refuses every request rather than
# opening. Generate with "npm run auth:hash", which prints this and the next one.
FAMILY_PASSWORD_HASH=

# The HMAC key the 30-day session cookie is signed with. At least 32 characters.
# Independent of the password: rotating this signs everybody out and leaves the
# password alone. "npm run auth:hash" generates one.
SESSION_SECRET=

# TMDB v4 read access token (a long JWT-style string), not the shorter v3 api_key.
# The watch-provider endpoints reject the v3 api_key scheme outright.
# Get it from https://www.themoviedb.org/settings/api under "API Read Access Token".
TMDB_READ_ACCESS_TOKEN=

# The shared family password, as a scrypt digest. Never the password itself and
# never a default: with this unset the app refuses every request rather than
# opening. Generate with "npm run auth:hash", which prints this and the next one.
FAMILY_PASSWORD_HASH=

# The HMAC key the 30-day session cookie is signed with. At least 32 characters.
# Independent of the password: rotating this signs everybody out and leaves the
# password alone. "npm run auth:hash" generates one.
SESSION_SECRET=

# Postgres. Vercel writes these when the Supabase integration is linked, and
# `vercel env pull` brings them down - run `npm run env:fix` afterwards, or the
# password gate refuses every request. POSTGRES_URL is the pooler on 6543,
# which the app uses. POSTGRES_URL_NON_POOLING is session mode on 5432 and is
# what the scripts use, because a migration or a long import has no business on
# a transaction pooler.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Set to "file" to ignore the database and read data/family.json instead. The
# way back to local work without unsetting a connection string. Anything else,
# including unset, means "use Postgres if it is configured".
STREAM_MASTER_STORE=
